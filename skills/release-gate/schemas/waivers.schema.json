{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Jenari-Dev/release-gate/schemas/waivers.schema.json",
  "title": "release-gate accepted risks (.release-gate/waivers.yaml)",
  "description": "A waiver records a risk the user explicitly accepted. It never turns a finding into a pass; it only changes how the verdict treats it, until it expires.",
  "type": "object",
  "required": ["schema_version", "waivers"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "waivers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "match", "reason", "owner", "expires", "created"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^W-[0-9]{3,}$" },
          "match": {
            "type": "object",
            "description": "Finding id or fingerprint this waiver covers",
            "minProperties": 1,
            "additionalProperties": false,
            "properties": {
              "finding_id": { "type": "string" },
              "fingerprint": { "type": "string" }
            }
          },
          "reason": { "type": "string", "minLength": 10 },
          "owner": { "type": "string" },
          "created": { "type": "string", "format": "date" },
          "expires": { "type": "string", "format": "date" }
        }
      }
    }
  }
}
